rules_version = '2';

// =========================================================================
// THE FIFTH FAMILY — VINCIGUERRA LUPO CARTEL TAX & TREASURY TRACKER
// Cloud Firestore Security Rules (Master Admin + Don Approval Gate)
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Master Admin is strictly oharajoshua333@gmail.com
    function isMasterAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'oharajoshua333@gmail.com';
    }

    // Check if the caller's profile document has role == 'Admin' or rank == 'Don' and is approved
    function isApprovedAdminOrDon() {
      return isMasterAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.approval_status == 'approved' &&
        (
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'Admin' ||
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.rank == 'Don'
        )
      );
    }

    // Check if caller is an approved cartel member
    function isApprovedMember() {
      return isMasterAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.approval_status == 'approved'
      );
    }

    // 1. COLLECTION: profiles
    // Newly registered users can create their own pending profile or read their own status.
    // Approved members can read roster profiles; only Master Admin or Don can approve/edit/remove members.
    match /profiles/{profileId} {
      allow read: if isSignedIn() && (request.auth.uid == profileId || isApprovedMember());
      allow create: if isSignedIn() && (request.auth.uid == profileId || isApprovedAdminOrDon());
      allow update, delete: if isApprovedAdminOrDon();
    }

    // 2. COLLECTION: tax_logic
    match /tax_logic/{bracketId} {
      allow read: if isSignedIn();
      allow write: if isApprovedAdminOrDon();
    }

    // 3. COLLECTION: weekly_contributions
    match /weekly_contributions/{recordId} {
      allow read: if isApprovedMember();
      allow create, update: if isApprovedAdminOrDon() || (
        isApprovedMember() && request.resource.data.player_id == request.auth.uid
      );
      allow delete: if isApprovedAdminOrDon();
    }

    // 4. COLLECTION: cartel_treasury_meta (Stores treasury balance, active week, and Custom HTML Welcome Banner)
    match /cartel_treasury_meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isApprovedAdminOrDon() || isApprovedMember();
    }
  }
}
